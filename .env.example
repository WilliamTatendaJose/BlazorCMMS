# Blazor CMMS Docker Environment Variables
# Copy this file to .env and update with your actual values

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
# For local SQL Server in Docker: use host.docker.internal
# For Azure SQL: use your Azure SQL connection string
DB_SERVER=host.docker.internal
DB_NAME=BlazorCMMS_Docker
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd

# Email Configuration (Resend)
EMAIL_RESEND_API_KEY=
EMAIL_FROM_EMAIL=noreply@rbmcmms.com
EMAIL_FROM_NAME=RBM CMMS

# WhatsApp Configuration (Meta Business API)
WHATSAPP_ENABLED=false
WHATSAPP_USE_LLM=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# WhatsApp LLM Configuration (Optional)
WHATSAPP_LLM_PROVIDER=Groq
WHATSAPP_LLM_GROQ_API_KEY=
WHATSAPP_LLM_OPENAI_API_KEY=
WHATSAPP_LLM_GEMINI_API_KEY=
